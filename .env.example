# ============================================================
# N8N Configuration
# ============================================================
N8N_ENCRYPTION_KEY=your-secure-random-key-min-16-chars
N8N_USER_MANAGEMENT_JWT_SECRET=your-secure-jwt-secret-min-16-chars

# ============================================================
# LLM Configuration (OpenAI)
# ============================================================
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-api-key
LLM_CHOICE=gpt-4o-mini
VISION_LLM_CHOICE=gpt-4o-mini

# Optional: OpenRouter fallback
# LLM_PROVIDER=openrouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-your-openrouter-key
# LLM_CHOICE=anthropic/claude-3.7-sonnet

# ============================================================
# Embedding Configuration (OpenAI)
# ============================================================
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-your-openai-api-key
EMBEDDING_MODEL_CHOICE=text-embedding-3-small

# ============================================================
# Database (Cloud Supabase)
# Create a project at https://supabase.com
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Option 1: Full connection URL (URL-encode special chars in password!)
# DATABASE_URL=postgresql://postgres:%5BSrne12%40Stock%5D@db.xxx.supabase.co:5432/postgres

# Option 2: Individual params (no URL encoding needed)
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-raw-password-here
DB_PORT=5432

# ============================================================
# Web Search (Brave)
# Get an API key at https://brave.com/search/api/
# ============================================================
BRAVE_API_KEY=your-brave-api-key

# ============================================================
# Frontend Environment Variables
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_AGENT_ENDPOINT=http://localhost:8001/api/pydantic-agent
VITE_ENABLE_STREAMING=true

# Optional: Langfuse integration for admin dashboard
# VITE_LANGFUSE_HOST_WITH_PROJECT=https://cloud.langfuse.com/project/your-project-id

# ============================================================
# Agent Observability (Langfuse - Optional)
# Create an account at https://cloud.langfuse.com
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# RAG Pipeline Configuration
# ============================================================
RAG_PIPELINE_TYPE=local
RUN_MODE=continuous
RAG_WATCH_DIRECTORY=./shared

# Optional: Google Drive RAG
# GOOGLE_DRIVE_CREDENTIALS_JSON=
# RAG_WATCH_FOLDER_ID=

# ============================================================
# Deployment Configuration
# ============================================================
ENVIRONMENT=development

# Optional: Custom domain hostnames for Caddy reverse proxy
# AGENT_API_HOSTNAME=agent.yourdomain.com
# FRONTEND_HOSTNAME=chat.yourdomain.com
